{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/DhruvPansuriya/C-Based-VLSI-Design-Course-Project/schemas/interpretation.schema.json",
  "title": "Interpretation",
  "description": "One reading of the request N: a shape, change clauses, an extended behaviour and a reach region. Expressions use the restricted contract grammar (TDD Section 6). Never derived from P1.",
  "type": "object",
  "required": [
    "id",
    "provenance",
    "shape",
    "clauses",
    "ext",
    "reach"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.:-]+$"
    },
    "provenance": {
      "type": "object",
      "required": [
        "source"
      ],
      "additionalProperties": false,
      "properties": {
        "source": {
          "enum": [
            "llm",
            "computed",
            "handwritten"
          ]
        },
        "model_family": {
          "type": "string"
        },
        "model_id": {
          "type": "string"
        },
        "prompt": {
          "enum": [
            "strict",
            "permissive",
            "adversarial",
            "typing",
            "shape"
          ]
        },
        "run_index": {
          "type": "integer",
          "minimum": 0
        },
        "computed_kind": {
          "enum": [
            "T3_ub_region",
            "T3_nd_region",
            "T5_identity"
          ]
        }
      }
    },
    "request_type": {
      "enum": [
        "T1",
        "T2",
        "T3",
        "T4",
        "T5",
        "T6"
      ]
    },
    "shape": {
      "$ref": "#/$defs/shape"
    },
    "clauses": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "zone",
          "behaviour"
        ],
        "additionalProperties": false,
        "properties": {
          "zone": {
            "$ref": "#/$defs/expr",
            "description": "predicate on initial inputs only"
          },
          "behaviour": {
            "$ref": "#/$defs/expr",
            "description": "relation over inputs, outputs (out_*) and old outputs (old_*)"
          },
          "uses_old_output": {
            "type": "boolean",
            "default": false
          },
          "nl_trace": {
            "type": "string",
            "description": "fragment of N this clause formalises"
          }
        }
      }
    },
    "ext": {
      "oneOf": [
        {
          "$ref": "#/$defs/expr"
        },
        {
          "const": "unknown"
        }
      ]
    },
    "reach": {
      "$ref": "#/$defs/expr",
      "description": "largest region the change could reasonably affect"
    },
    "nl_rendering": {
      "type": "string"
    }
  },
  "$defs": {
    "expr": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "shape": {
      "type": "object",
      "required": [
        "buffers",
        "alias",
        "bounds"
      ],
      "additionalProperties": false,
      "properties": {
        "buffers": {
          "type": "object",
          "description": "pointer parameter -> number of elements as an expression over size parameters",
          "additionalProperties": {
            "$ref": "#/$defs/expr"
          }
        },
        "alias": {
          "enum": [
            "disjoint"
          ],
          "description": "only 'disjoint' is supported in the first implementation"
        },
        "bounds": {
          "type": "object",
          "description": "size parameter -> [min, max] (max <= K)",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "integer"
            },
            "minItems": 2,
            "maxItems": 2
          }
        },
        "value_bounds": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "integer"
            },
            "minItems": 2,
            "maxItems": 2
          }
        },
        "globals": {
          "type": "object",
          "additionalProperties": {
            "enum": [
              "const_program",
              "input_output"
            ]
          }
        }
      }
    }
  }
}
