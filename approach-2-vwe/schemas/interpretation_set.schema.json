{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/DhruvPansuriya/C-Based-VLSI-Design-Course-Project/schemas/interpretation_set.schema.json",
  "title": "InterpretationSet",
  "description": "Frozen set of interpretations after objective validation. The verdict is a function of (inputs, this set). sha256 is computed over the canonical JSON (sorted keys, no whitespace) of 'members'.",
  "type": "object",
  "required": ["task_id", "sha256", "members", "discarded", "generation"],
  "additionalProperties": false,
  "properties": {
    "task_id": {"type": "string"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "members": {"type": "array", "items": {"$ref": "interpretation.schema.json"}},
    "discarded": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "check", "detail"],
        "properties": {
          "id": {"type": "string"},
          "check": {"enum": ["V-G", "V-1", "V-2", "V-3", "V-4", "V-5"]},
          "detail": {"type": "string"}
        }
      }
    },
    "informational": {
      "type": "object",
      "properties": {
        "equivalence_classes": {"type": "array", "items": {"type": "array", "items": {"type": "string"}}},
        "example_agreement": {"type": "object", "additionalProperties": {"type": "number"}},
        "strict_permissive_distinct": {"type": "boolean"}
      }
    },
    "generation": {
      "type": "object",
      "required": ["runs", "families"],
      "properties": {
        "runs": {"type": "integer", "minimum": 1},
        "families": {"type": "array", "items": {"type": "string"}, "minItems": 1},
        "p1_seen_by_any_llm": {"const": false}
      }
    }
  }
}
